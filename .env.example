# Names and safe local defaults only. In Kubernetes every value comes from env vars and
# secrets from External Secrets (ADR-003). Never commit a real .env.

# ---- App ----
NODE_ENV=development
PORT=4000
REALTIME_PORT=4001
# Probes and metrics for every process (/health/live, /health/ready, /metrics). Never exposed publicly.
OPS_PORT=9464
API_PREFIX=/api/v1
# Proxy hops in front of the app (0 locally; 1 behind ingress-nginx; 2 with Cloudflare in front too)
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=
# Time between failing readiness and closing servers on SIGTERM
SHUTDOWN_DRAIN_MS=5000

# ---- Browser origins (ADR-004) ----
# Comma-separated; "*" matches exactly one DNS label, e.g. http://*.kriraghor.localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://*.kriraghor.localhost
ADMIN_ORIGINS=http://localhost:3002,http://admin.kriraghor.localhost

# ---- Database (PostgreSQL 17) ----
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=kriraghor
DB_USER=kriraghor
DB_PASSWORD=kriraghor
DB_LOGGING=false
# Connections per process (api, realtime and worker each have a pool)
DB_POOL_MAX=10

# ---- Redis (BullMQ, rate limits, Socket.IO adapter) ----
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=kg

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_SPECIAL_SECRET=change-me-special-secret-at-least-32-chars
CSRF_SECRET=change-me-csrf-secret-at-least-32-characters
COOKIE_SECURE=false
# Cookie names are <prefix>_rt, <prefix>_si, ... (kg in prod, kgstg in staging)
COOKIE_PREFIX=kg
# Domain for the readable hint and CSRF cookies. Empty on plain localhost ports;
# .kriraghor.localhost in k3d; .kriraghor.com in prod; .staging.kriraghor.com in staging.
COOKIE_HINT_DOMAIN=
# 32-byte key (base64) used to encrypt TOTP secrets at rest
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
OTP_HASH_SECRET=change-me-otp-hmac-secret
# M02: HMAC key for NID duplicate detection (never rotate without re-hashing)
NID_HMAC_SECRET=change-me-nid-hmac-secret

# ---- SMS ----
SMS_DRIVER=console

# ---- Push to the mobile app (M08) ----
# log: prints one line per message; expo: sends through the Expo push API (staging and production).
PUSH_DRIVER=log
# Only when the Expo project turns on enhanced push security (from expo.dev → Access tokens).
# EXPO_ACCESS_TOKEN=

# ---- Security tuning ----
PASSWORD_BREACH_CHECK=false
# OTP, login lockout, session lifetimes, staff timeouts and rate limits are platform settings
# (M03 auth.* and ratelimit.*), changed on the admin Fees and rules screen, not here.

# ---- Email (OTP codes by email) ----
# console = print to terminal, smtp = real delivery (use Mailpit locally: docker compose up -d, UI http://localhost:8025)
EMAIL_DRIVER=smtp
EMAIL_FROM="Kriraghor <no-reply@kriraghor.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Google sign-in ----
# OAuth 2.0 Client IDs from Google Cloud Console (APIs & Services > Credentials), comma-separated
GOOGLE_CLIENT_IDS=

# ---- Public app URLs (links in notification emails) ----
WEB_APP_URL=http://localhost:3000
ESPORTS_APP_URL=http://localhost:3001
# Payments started in the mobile app return here (the app's URL scheme)
APP_RETURN_URL=kriraghor://pay
VENDOR_APP_URL=http://localhost:3002/vendor
ADMIN_APP_URL=http://localhost:3002

# M06 payments. The gateway posts IPNs to, and returns the payer through, this public API origin.
API_PUBLIC_URL=http://localhost:4000
PAYMENT_PROVIDER=sslcommerz
# Built-in SSLCommerz-compatible simulator at /dev/sslcommerz (local only; refused in production).
PAYMENTS_SIMULATOR=true
# Masters can create test charges (dev and staging only).
PAYMENTS_TEST_CHARGES=true
# Real sandbox: SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com plus your sandbox store ID and password.
SSLCOMMERZ_BASE_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---- Object storage (S3-compatible; SeaweedFS from docker compose locally) ----
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=auto
S3_ACCESS_KEY=kriraghor
S3_SECRET_KEY=kriraghor-dev-s3-secret
# Private bucket (audit exports now; KYC files from M02). Created on first use locally.
S3_BUCKET_PRIVATE=kriraghor-private
S3_BUCKET_PUBLIC=kriraghor-public
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8333/kriraghor-public
S3_CREATE_BUCKETS=true
