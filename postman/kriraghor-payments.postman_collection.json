{
  "info": {
    "name": "Kriraghor API: M06 Payments, ledger and escrow",
    "description": "A master creates a ৳100 test charge; the payer pays with bKash on the SSLCommerz simulator; the money waits in escrow; the master releases it with step-up (payee ৳95, fee ৳5); a partial refund goes back through the gateway; the day is reconciled and the ledger checks pass.\n\nUnattended: `node postman/run-m06.js` (uses the kriraghor_test database and the built-in simulator).\n\nRebuild this file with: node postman/build-collection-m06.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "payerId",
      "value": ""
    },
    {
      "key": "payeeId",
      "value": ""
    },
    {
      "key": "stepUpToken",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "paymentCode",
      "value": ""
    },
    {
      "key": "holdId",
      "value": ""
    },
    {
      "key": "gatewayPay",
      "value": ""
    },
    {
      "key": "returnUrl",
      "value": ""
    },
    {
      "key": "refundId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "businessDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Guards",
      "item": [
        {
          "name": "Test charge as a payer (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 401', () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{payerId}}\",\n  \"payeeId\": \"{{payeeId}}\",\n  \"amount\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/payments/test-charges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payments",
                "test-charges"
              ]
            }
          }
        },
        {
          "name": "Test charge without an Idempotency-Key (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 400 IDEMPOTENCY_KEY_REQUIRED', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(j && j.code).to.eql('IDEMPOTENCY_KEY_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{payerId}}\",\n  \"payeeId\": \"{{payeeId}}\",\n  \"amount\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/payments/test-charges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payments",
                "test-charges"
              ]
            }
          }
        },
        {
          "name": "Test charge above the maximum (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 422', () => {",
                  "  pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{payerId}}\",\n  \"payeeId\": \"{{payeeId}}\",\n  \"amount\": 100001\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/payments/test-charges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payments",
                "test-charges"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Pay into escrow",
      "item": [
        {
          "name": "Master creates a ৳100 test charge",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'payment.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('paymentId', v); }",
                  "if (ok && j) { const v = get(j, 'payment.code'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('paymentCode', v); }",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"initiated, PAY code\", () => { pm.expect(j.payment.status === 'initiated' && /^PAY-\\d{2}-\\d{6}$/.test(j.payment.code)).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{payerId}}\",\n  \"payeeId\": \"{{payeeId}}\",\n  \"amount\": 10000,\n  \"title\": \"Postman test charge\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/payments/test-charges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payments",
                "test-charges"
              ]
            }
          }
        },
        {
          "name": "Payer opens the payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"three methods\", () => { pm.expect(j.methods.join() === 'bkash,nagad,card' && j.amount === 10000).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          }
        },
        {
          "name": "Payer starts paying with bKash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (j && j.redirectUrl) pm.collectionVariables.set('gatewayPay', j.redirectUrl);",
                  "pm.test('gateway page', () => pm.expect(j.redirectUrl).to.match(/\\/dev\\/sslcommerz\\/pay\\//));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"bkash\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "attempts"
              ]
            }
          }
        },
        {
          "name": "Gateway: the payer pays (simulator)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('303 back to the API', () => pm.response.to.have.status(303));",
                  "const loc = pm.response.headers.get('Location'); pm.collectionVariables.set('returnUrl', loc);",
                  "pm.test('return URL carries tran_id and val_id', () => pm.expect(loc).to.match(/payments\\/return\\/sslcommerz\\?pid=.*tran_id=.*val_id=/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "outcome",
                  "value": "success"
                }
              ]
            },
            "url": "{{gatewayPay}}"
          }
        },
        {
          "name": "Browser comes back through the return URL",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('303 to the web result page', () => pm.response.to.have.status(303));",
                  "pm.test('result page', () => pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/pay/' + pm.collectionVariables.get('paymentId') + '/result$')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{returnUrl}}"
          }
        },
        {
          "name": "Payment succeeded (verified by the server)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"succeeded with bKash\", () => { pm.expect(j.status === 'succeeded' && j.captured === 10000 && j.methodDisplay === 'bKash ••• 4321').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          }
        },
        {
          "name": "Finance sees the hold and the capture posting",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'hold.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('holdId', v); }",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"holding ৳100, fee 5% snapshotted\", () => { pm.expect(j.hold.status === 'holding' && j.hold.available === 10000 && j.hold.fee.bps === 500).to.eql(true); });",
                  "pm.test(\"capture posted\", () => { pm.expect(j.ledger.length === 1 && j.ledger[0].kind === 'payment.capture').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payments",
                "{{paymentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Release and refund",
      "item": [
        {
          "name": "Release without step-up (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 403 STEP_UP_REQUIRED', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(j && j.code).to.eql('STEP_UP_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman exit check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/escrow/{{holdId}}/release",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "escrow",
                "{{holdId}}",
                "release"
              ]
            }
          }
        },
        {
          "name": "Master releases with step-up",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const q = String(pm.variables.get('stepUpQueueA') || '').split(',').filter(Boolean);",
                  "if (q.length) { pm.variables.set('stepUpToken', q.shift()); pm.environment.set('stepUpQueueA', q.join(',')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"payee ৳66.50, fee ৳3.50\", () => { pm.expect(j.gross === 7000 && j.fee === 350 && j.net === 6650 && j.hold.status === 'partially_released').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "X-Step-Up",
                "value": "{{stepUpToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 7000,\n  \"reason\": \"Postman exit check: first tranche\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/escrow/{{holdId}}/release",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "escrow",
                "{{holdId}}",
                "release"
              ]
            }
          }
        },
        {
          "name": "Refund ৳20 of what is still held",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('refundId', v); }",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"approved from escrow\", () => { pm.expect(j.status === 'approved' && j.source === 'escrow').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"amount\": 2000,\n  \"reasonCode\": \"customer_request\",\n  \"reasonText\": \"Postman partial refund\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "refunds"
              ]
            }
          }
        },
        {
          "name": "Refund more than is left (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 422 REFUND_EXCEEDS_HELD', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(j && j.code).to.eql('REFUND_EXCEEDS_HELD');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"amount\": 1001,\n  \"reasonCode\": \"customer_request\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "refunds"
              ]
            }
          }
        },
        {
          "name": "The gateway confirmed the refund",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
