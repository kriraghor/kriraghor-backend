{
  "info": {
    "name": "Kriraghor API: M03 Settings & esports catalogue",
    "description": "Fees and rules (platform_settings), history, four-eyes change requests and the esports catalogue.\n\nUnattended: `node postman/run-m03.js` (uses the kriraghor_test database, two test masters and pre-minted step-up tokens).\n\nBy hand: sign in two masters with the M01 collection (folder 3), copy their admin access tokens into adminAccessToken and adminAccessToken2, then run each \"Step-up\" request before a write.\n\nRebuild this file with: node postman/build-collection-m03.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminAccessToken2",
      "value": ""
    },
    {
      "key": "totp",
      "value": ""
    },
    {
      "key": "totpB",
      "value": ""
    },
    {
      "key": "stepUpToken",
      "value": ""
    },
    {
      "key": "stepUpTokenB",
      "value": ""
    },
    {
      "key": "singleRequestId",
      "value": ""
    },
    {
      "key": "feeRequestId",
      "value": ""
    },
    {
      "key": "pubgGameId",
      "value": ""
    },
    {
      "key": "mapId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Public (no sign-in)",
      "item": [
        {
          "name": "Public settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"ground fee is public, shop commission is not\", () => { pm.expect(j.fees.groundBookingPct === 5 && j.fees.shopCommissionPct === undefined).to.eql(true); });",
                  "pm.test(\"money as amount + currency\", () => { pm.expect(j.market.deliveryFeeDhaka.amount === 8000 && j.market.deliveryFeeDhaka.currency === 'BDT').to.eql(true); });",
                  "pm.test(\"cache header\", () => { pm.expect(pm.response.headers.get('Cache-Control') === 'public, max-age=300').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/settings/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "settings",
                "public"
              ]
            }
          }
        },
        {
          "name": "Esports games catalogue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'items.0.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('pubgGameId', v); }",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"PUBG Mobile then Free Fire\", () => { pm.expect(j.items.map((g) => g.key).join() === 'pubg_mobile,free_fire').to.eql(true); });",
                  "pm.test(\"PUBG squad is 25 × 4\", () => { pm.expect(j.items[0].modes.some((m) => m.key === 'squad' && m.maxTeams === 25 && m.teamSize === 4)).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/esports/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalog",
                "esports",
                "games"
              ]
            }
          }
        }
      ]
    },
