    {
      "name": "3. Single-approval change (applies at once)",
      "item": [
        {
          "name": "Room reveal 15 → 10 min",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const q = String(pm.variables.get('stepUpQueueA') || '').split(',').filter(Boolean);",
                  "if (q.length) { pm.variables.set('stepUpToken', q.shift()); pm.environment.set('stepUpQueueA', q.join(',')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('singleRequestId', v); }",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"applied\", () => { pm.expect(j.status === 'applied' && j.needsFourEyes === false).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "X-Step-Up",
                "value": "{{stepUpToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changes\": [\n    {\n      \"key\": \"esports.room_reveal_minutes\",\n      \"to\": 10\n    }\n  ],\n  \"reason\": \"Postman acceptance run\"\n}",
