{
  "info": {
    "name": "Kriraghor API: M08 Notifications (Phase 1 exit check)",
    "description": "Master A proposes a fee change with step-up; master B is asked to approve; B approves; A gets the critical alert. Plus the bell, preferences and the delivery log.\n\nUnattended: `node postman/run-m08.js` (uses the kriraghor_test database).\n\nRebuild this file with: node postman/build-collection-m08.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminAccessToken2",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "stepUpToken",
      "value": ""
    },
    {
      "key": "stepUpTokenB",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Guards",
      "item": [
        {
          "name": "Bell without a token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 401 AUTH_REQUIRED', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(j && j.code).to.eql('AUTH_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notifications"
              ]
            }
          }
        },
        {
          "name": "Turn off a mandatory cell (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 422 PREF_MANDATORY', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(j && j.code).to.eql('PREF_MANDATORY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prefs\": [\n    {\n      \"category\": \"security\",\n      \"channel\": \"sms\",\n      \"enabled\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/me/notification-prefs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-prefs"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Phase 1 exit check",
      "item": [
        {
          "name": "A proposes shop commission 5 → 6% (step-up)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const q = String(pm.variables.get('stepUpQueueA') || '').split(',').filter(Boolean);",
                  "if (q.length) { pm.variables.set('stepUpToken', q.shift()); pm.environment.set('stepUpQueueA', q.join(',')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('requestId', v); }",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"waiting for a second master\", () => { pm.expect(j.status === 'proposed').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "X-Step-Up",
                "value": "{{stepUpToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changes\": [\n    {\n      \"key\": \"fees.shop_commission_pct\",\n      \"to\": 6\n    }\n  ],\n  \"reason\": \"Postman M08 exit check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/settings/change-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "settings",
                "change-requests"
              ]
            }
          }
        },
        {
          "name": "B's bell asks for approval",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"approval needed\", () => { pm.expect(j.unreadCount === 1 && j.items[0].code === 'SETTING_CHANGE_PROPOSED' && j.items[0].title === 'Approval needed').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/me/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "me",
                "notifications"
              ]
            }
          }
        },
        {
          "name": "B approves (step-up)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const q = String(pm.variables.get('stepUpQueueB') || '').split(',').filter(Boolean);",
                  "if (q.length) { pm.variables.set('stepUpTokenB', q.shift()); pm.environment.set('stepUpQueueB', q.join(',')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"applied\", () => { pm.expect(j.status === 'applied').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken2}}"
              },
              {
                "key": "X-Step-Up",
                "value": "{{stepUpTokenB}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Agreed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/settings/change-requests/{{requestId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "settings",
                "change-requests",
                "{{requestId}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "The change is in the audit log (critical, step-up)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"critical + step-up\", () => { pm.expect(j.items[0].severity === 'critical' && j.items[0].stepUp === true).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?action=setting.changed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "setting.changed"
                }
              ]
            }
          }
        },
        {
          "name": "A's bell has the critical alert",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"critical change\", () => { pm.expect(j.items.some((n) => n.code === 'AUDIT_CRITICAL' && n.body.includes('fees.shop_commission_pct'))).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/me/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "me",
                "notifications"
              ]
            }
          }
        },
        {
          "name": "B is not alerted about B's own change",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"no AUDIT_CRITICAL for the actor\", () => { pm.expect(!j.items.some((n) => n.code === 'AUDIT_CRITICAL')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/me/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "me",
                "notifications"
              ]
            }
          }
        },
        {
          "name": "Emails went out (delivery log)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"two emails sent\", () => { pm.expect(j.items.filter((d) => d.channel === 'email' && d.status === 'sent').length === 2).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/notifications/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "notifications",
                "deliveries"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Bell",
      "item": [
        {
          "name": "Unread count",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"one unread\", () => { pm.expect(j.unreadCount === 1).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/me/notifications/unread-count",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "me",
                "notifications",
                "unread-count"
              ]
            }
          }
        },
        {
          "name": "Mark all read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"none unread\", () => { pm.expect(j.unreadCount === 0).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"all\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/me/notifications/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "me",
                "notifications",
                "read"
              ]
            }
          }
        },
        {
          "name": "Member bell (empty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"empty\", () => { pm.expect(j.items.length === 0 && j.unreadCount === 0).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notifications"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Preferences",
      "item": [
        {
          "name": "Read preferences",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"security SMS locked\", () => { pm.expect(j.categories.find((c) => c.category === 'security').channels.find((c) => c.channel === 'sms').locked === true).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/notification-prefs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-prefs"
              ]
            }
          }
        },
        {
          "name": "Turn off moderation SMS and quiet hours",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"saved\", () => { pm.expect(j.quietHours === false && j.categories.find((c) => c.category === 'moderation').channels.find((c) => c.channel === 'sms').enabled === false).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prefs\": [\n    {\n      \"category\": \"moderation\",\n      \"channel\": \"sms\",\n      \"enabled\": false\n    }\n  ],\n  \"quietHours\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/me/notification-prefs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-prefs"
              ]
            }
          }
        }
      ]
    }
  ]
}
