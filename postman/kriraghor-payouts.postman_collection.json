    {
      "name": "1. Payout account",
      "item": [
        {
          "name": "Payee adds a bKash account (code from the SMS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('accountId', v); }",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"masked, waiting for review\", () => { pm.expect(j.masked === 'bKash ••• 5678' && j.status === 'pending_verification' && !JSON.stringify(j).includes('01712345678')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"bkash\",\n  \"accountNo\": \"01712345678\",\n  \"accountName\": \"Nusrat Jahan\",\n  \"code\": \"{{accountCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/me/payout-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "payout-accounts"
              ]
            }
          }
        },
        {
          "name": "Finance sees it next to the NID name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"in the queue, masked\", () => { pm.expect(j.items.length === 1 && j.items[0].id === pm.collectionVariables.get('accountId') && j.items[0].sameWalletUsers === 0 && !JSON.stringify(j).includes('01712345678')).to.eql(true); });"
                ]
