              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'items.0.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('payoutId', v); }",
                  "if (ok && j) { const v = get(j, 'items.0.code'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('payoutCode', v); }",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"৳95 from ৳100 less the 5% fee\", () => { pm.expect(j.items.length === 1 && j.items[0].amount === 9500 && j.items[0].gross === 10000 && j.items[0].deductions === 500 && j.items[0].account.masked === 'bKash ••• 5678').to.eql(true); });"
                ]
              }
            }
