{
  "info": {
    "name": "Kriraghor API: M07 Payouts",
    "description": "The payee adds a bKash payout account with a code from their phone; finance verifies it against the NID name; the daily run turns the released ৳95 into a payout; above the (lowered) four-eyes threshold, masters A and B approve it with step-up; finance reveals the wallet number (audited), sends it by hand and marks it paid with the bKash reference; the payee sees it and the ledger checks pass.\n\nUnattended: `node postman/run-m07.js` (uses the kriraghor_test database).\n\nRebuild this file with: node postman/build-collection-m07.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminAccessToken2",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "accountCode",
      "value": ""
    },
    {
      "key": "stepUpToken",
      "value": ""
    },
    {
      "key": "stepUpTokenB",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "payoutId",
      "value": ""
    },
    {
      "key": "payoutCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Guards",
      "item": [
        {
          "name": "Payout list without a staff token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 401', () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/payouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payouts"
              ]
            }
          }
        },
        {
          "name": "Add an account with a wrong number (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 422 PAYOUT_ACCOUNT_INVALID', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(j && j.code).to.eql('PAYOUT_ACCOUNT_INVALID');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"bkash\",\n  \"accountNo\": \"01212345678\",\n  \"accountName\": \"Nusrat Jahan\",\n  \"code\": \"{{accountCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/me/payout-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "payout-accounts"
              ]
            }
          }
        }
      ]
