                  "if (ok && j) { const v = get(j, 'consent.version'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('consentVersion', v); }",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"phone done, NID missing\", () => { pm.expect(j.badge === 'verification_needed' && j.items[0].status === 'approved' && j.items[1].status === 'missing').to.eql(true); });",
                  "pm.test(\"consent text and minimum age\", () => { pm.expect(Number.isInteger(j.consent.version) && j.consent.draft === true && j.consent.text.startsWith('I agree that Kriraghor uses these documents') && j.consent.text.includes('90 days') && j.consent.text.includes('aged 18 and over') && j.minAgeYears === 18).to.eql(true); });"
