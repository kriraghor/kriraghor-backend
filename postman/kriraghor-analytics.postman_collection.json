                  "pm.test(\"bookings by day add up to the tile\", () => { pm.expect(j.charts.bookingsByDay.reduce((n, x) => n + x.value, 0) === j.tiles.bookings.value).to.eql(true); });",
                  "pm.test(\"revenue by ground adds up to the tile\", () => { pm.expect(j.charts.revenueByGround.reduce((n, x) => n + x.value, 0) === j.tiles.revenue.value).to.eql(true); });",
                  "pm.test(\"asOf and definitions\", () => { pm.expect(!!j.asOf && j.definitions.revenue.includes('before the Kriraghor fee')).to.eql(true); });"
                ]
              }
            }
