                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'items.0.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('sub1', v); }",
                  "if (ok && j) { const v = get(j, 'items.1.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('sub2', v); }",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"two documents waiting\", () => { pm.expect(j.items.length === 2 && j.items.every((i) => i.kind === 'document' && i.status === 'pending_review' && i.sla === 'ok' && i.claim === null)).to.eql(true); });",
                  "pm.test(\"member 1 first\", () => { pm.expect(j.items[0].submittedBy.id === pm.variables.get('member1Id')).to.eql(true); });"
                ]
              }
            }
          ],
