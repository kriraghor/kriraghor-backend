{
  "info": {
    "name": "Kriraghor API: M04 Audit log & events",
    "description": "Audit log search, entity history, the hash chain, exports, outbox health and replay.\n\nUnattended: `node postman/run-m04.js` (uses the kriraghor_test database).\n\nRebuild this file with: node postman/build-collection-m04.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "stepUpToken",
      "value": ""
    },
    {
      "key": "auditId",
      "value": ""
    },
    {
      "key": "exportId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Guards",
      "item": [
        {
          "name": "Audit log without a token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 401 AUTH_REQUIRED', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(j && j.code).to.eql('AUTH_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ]
            }
          }
        },
        {
          "name": "Range over a year (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 422 RANGE_TOO_LARGE', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(j && j.code).to.eql('RANGE_TOO_LARGE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?from=2024-01-01T00:00:00Z&to=2026-01-01T00:00:00Z",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2024-01-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-01-01T00:00:00Z"
                }
              ]
            }
          }
        },
        {
          "name": "Export without step-up (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 403 STEP_UP_REQUIRED', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(j && j.code).to.eql('STEP_UP_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs/exports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs",
                "exports"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Audit search (master)",
      "item": [
        {
          "name": "Last 7 days",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'items.0.id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('auditId', v); }",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"has entries with EN and BN summaries\", () => { pm.expect(j.items.length > 0 && Boolean(j.items[0].summary.en && j.items[0].summary.bn)).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Only sign-ins",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"all sign-ins\", () => { pm.expect(j.items.every((i) => i.action === 'auth.signed_in')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?action=auth.signed_in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "auth.signed_in"
                }
              ]
            }
          }
        },
        {
          "name": "One entry with chain status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"chain status present\", () => { pm.expect(typeof j.chain.sealed === 'boolean').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs/{{auditId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs",
                "{{auditId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. A fee-like change is audited as critical",
      "item": [
        {
          "name": "Room reveal 15 → 12 min (step-up settings.write)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const q = String(pm.variables.get('stepUpQueueA') || '').split(',').filter(Boolean);",
                  "if (q.length) { pm.variables.set('stepUpToken', q.shift()); pm.environment.set('stepUpQueueA', q.join(',')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"applied\", () => { pm.expect(j.status === 'applied').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "X-Step-Up",
                "value": "{{stepUpToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changes\": [\n    {\n      \"key\": \"esports.room_reveal_minutes\",\n      \"to\": 12\n    }\n  ],\n  \"reason\": \"Postman M04 run\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/settings/change-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "settings",
                "change-requests"
              ]
            }
          }
        },
        {
          "name": "setting.changed is critical with step-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"critical + step-up + diff\", () => { pm.expect(j.items[0].severity === 'critical' && j.items[0].stepUp === true && j.items[0].before.value === 15 && j.items[0].after.value === 12).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?action=setting.changed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "setting.changed"
                }
              ]
            }
          }
        },
        {
          "name": "Entity history of the setting",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"has the change\", () => { pm.expect(j.items.some((i) => i.action === 'setting.changed')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/entities/platform_setting/esports.room_reveal_minutes/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "entities",
                "platform_setting",
                "esports.room_reveal_minutes",
                "history"
              ]
            }
          }
        }
      ]
    },
