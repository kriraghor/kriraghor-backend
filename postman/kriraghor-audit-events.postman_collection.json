                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "X-Step-Up",
                "value": "{{stepUpToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"action\": \"setting.changed\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs/exports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "audit-logs",
                "exports"
              ]
            }
          }
        },
