            "url": {
              "raw": "{{baseUrl}}/admin/events?status=dead",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "events"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "dead"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Export",
      "item": [
        {
          "name": "Request a CSV export (step-up audit.export)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const q = String(pm.variables.get('stepUpQueueA') || '').split(',').filter(Boolean);",
                  "if (q.length) { pm.variables.set('stepUpToken', q.shift()); pm.environment.set('stepUpQueueA', q.join(',')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "if (ok && j) { const v = get(j, 'id'); if (v !== undefined && v !== null && v !== '') pm.collectionVariables.set('exportId', v); }",
                  "pm.test('status 202', () => {",
                  "  pm.response.to.have.status(202);",
                  "});"
                ]
