      "name": "1. The flag (FR-01 to FR-05)",
      "item": [
        {
          "name": "Overview: one critical flag",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = null; try { j = pm.response.json(); } catch (e) {}",
                  "const get = (o, p) => p.split('.').filter(Boolean).reduce((a, k) => (a == null ? undefined : a[k]), o);",
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"critical 1\", () => { pm.expect(j.counts.critical === 1).to.eql(true); });",
                  "pm.test(\"NID rule threshold 1\", () => { pm.expect(j.rules.find((r) => r.key === 'accounts_per_nid').threshold === 1).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/risk/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "risk",
                "overview"
              ]
            }
          }
        },
        {
