{
  "name": "kriraghor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kriraghor backend API (Express + Sequelize + MySQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:realtime": "nodemon src/realtime.js",
    "dev:worker": "nodemon src/worker.js",
    "start": "node src/server.js",
    "start:realtime": "node src/realtime.js",
    "start:worker": "node src/worker.js",
    "migrate": "sequelize-cli db:migrate",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "create:master": "node scripts/create-master.js",
    "openapi": "node scripts/openapi.js",
    "test": "jest --runInBand --coverage",
    "lint": "eslint src tests scripts",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.15",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
