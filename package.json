{
  "name": "kriraghor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kriraghor backend API (Express + Sequelize + MySQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "create:master": "node scripts/create-master.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests scripts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
